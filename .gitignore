# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test


# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.txt

# Dependency directories (remove the comment below to include it)
vendor/

.idea
*.impl

# IDE Cache
.vscode
.DS_Store

# Compiled example binaries. `go build` inside an example directory emits an
# extensionless executable named after that directory, which none of the rules
# above match (they cover .exe/.so/.dylib/.test).
/examples/*/using-*
/examples/*/http-server*
/examples/*/sample-cmd
/examples/grpc/*/grpc-*
!/examples/**/*.go
!/examples/**/*.md
!/examples/**/*.mod
!/examples/**/*.sum
!/examples/**/*.yaml
!/examples/**/*.yml
!/examples/**/*.json
