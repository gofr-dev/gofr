# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Compiled example binaries: `go build` inside examples/<name>/ emits a binary
# named after the directory (no extension). These are build artifacts, never
# commit them. Keep sources, Dockerfiles, and subdirectories (configs/, static/).
examples/*/*
!examples/*/*.*
!examples/*/*/
!examples/*/Dockerfile


# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.txt

# Dependency directories (remove the comment below to include it)
vendor/

.idea
*.impl

# IDE Cache
.vscode
.DS_Store
