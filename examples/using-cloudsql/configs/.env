APP_NAME=using-cloudsql
HTTP_PORT=8000

# Cloud SQL instance connection name: "project:region:instance".
DB_HOST=my-project:us-central1:my-instance
DB_DIALECT=postgres
DB_NAME=app

# IAM database user. For a service account, use the email with the
# ".gserviceaccount.com" suffix removed (e.g. app-sa@my-project.iam).
DB_USER=app-sa@my-project.iam

# IAM auth on the cloud: no password needed, credentials come from Application
# Default Credentials (supports Workload Identity Federation).
DB_IAM_AUTH=true

# PUBLIC | PRIVATE | PSC
DB_CLOUDSQL_IP_TYPE=PUBLIC

# For local development against built-in auth instead, set:
#   DB_IAM_AUTH=false
#   DB_HOST=localhost          # plain pq/mysql can't resolve "project:region:instance"
#   DB_PORT=5432
#   DB_USER=postgres
#   DB_PASSWORD=your-password
