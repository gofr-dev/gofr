HTTP_PORT=9016

APP_NAME=using-otlp-metrics
APP_VERSION=v0.1.0

# The Prometheus pull endpoint stays available alongside OTLP push.
# Set METRICS_PORT=0 for push-only (serverless / scale-to-zero) deployments.
METRICS_PORT=2124

# Push metrics to an OTLP collector/backend.
METRICS_EXPORTER=otlp
METRICS_URL=localhost:4317
METRICS_PROTOCOL=grpc
METRICS_EXPORT_INTERVAL=15
METRICS_TEMPORALITY=cumulative
METRICS_INSECURE=true
