APP_NAME=using-s3-filestore
HTTP_PORT=8100

LOG_LEVEL=DEBUG

# MinIO / S3-compatible object store.
# Endpoint points at the MinIO service; in CI this is the MinIO service container.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=gofr-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
