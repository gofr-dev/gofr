HTTP_PORT=8080

APP_NAME=using-gcp-metrics
APP_VERSION=v0.1.0

# Push-only: disable the pull endpoint (serverless / scale-to-zero).
METRICS_PORT=0

# Keyless push to Google Managed Prometheus via the attached service account
# (Application Default Credentials). METRICS_URL defaults to
# telemetry.googleapis.com:443, so it is intentionally left unset.
METRICS_EXPORTER=gcp
METRICS_EXPORT_INTERVAL=30
