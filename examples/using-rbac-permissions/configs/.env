APP_NAME=using-rbac-permissions
HTTP_PORT=8000

# JWKS endpoint of your identity provider; the tests point this at a local test server.
JWKS_URL=https://auth.example.com/.well-known/jwks.json

# The issuer your identity provider puts in "iss"; tokens from any other issuer are rejected.
TOKEN_ISSUER=https://auth.example.com/
