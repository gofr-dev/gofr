APP_NAME=using-rbac-extractor
HTTP_PORT=8000

# JWKS endpoint of your identity provider; the tests point this at a local test server.
JWKS_URL=https://auth.example.com/.well-known/jwks.json

# The issuer your identity provider puts in "iss"; tokens from any other issuer are rejected.
TOKEN_ISSUER=https://auth.example.com/

# A registered route that no RBAC rule covers is served with no authorization. "fail" stops
# startup when that happens, instead of only logging it. Keep it when you copy this example.
GOFR_RBAC_ROUTE_CHECK=fail

# How long the extractor may take for one request; unset means 5s.
RBAC_EXTRACTOR_TIMEOUT=2s
