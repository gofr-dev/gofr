HTTP_PORT=8080

APP_NAME=using-gcp-traces
APP_VERSION=v0.1.0

# Keyless span export to Google Cloud via the attached service account
# (Application Default Credentials). TRACER_URL defaults to
# telemetry.googleapis.com:443, so it is intentionally left unset — set it only
# to pin a regional endpoint (telemetry.<region>.rep.googleapis.com:443).
TRACE_EXPORTER=gcp

# Head-based sampling. 1 sends every trace; lower it on a busy service.
TRACER_RATIO=1
